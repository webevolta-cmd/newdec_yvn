# Copy to .env for local development (`cp .env.example .env`). Never commit real values.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# ── Where inquiries are delivered (required for the forms to send) ───────────────────────
# One or more recipient addresses, comma-separated. Use the address NEW DEC confirms.
INQUIRY_TO_EMAIL=owner@example.com
# Sender shown in the e-mail. With Resend it must be on a domain verified in your Resend account,
# e.g. "NEW DEC կայք <website@your-domain.am>". For a quick Resend test without a domain use
# "NEW DEC <onboarding@resend.dev>" (Resend then only delivers to your own Resend account address).
INQUIRY_FROM_EMAIL=NEW DEC website <website@example.com>
# Optional prefix for the subject line, e.g. "[TEST]" on preview deployments.
INQUIRY_SUBJECT_PREFIX=

# ── Option A: Resend (recommended) ─────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Option B: any SMTP mailbox (used only when RESEND_API_KEY is empty) ───────────────────
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=the Gmail address,
# SMTP_PASS=an app password (Google Account → Security → App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# ── Optional hardening ────────────────────────────────────────────────────────────────────
# Requests per visitor (IP) per 10 minutes. Default 5; 0 disables (only for local testing).
INQUIRY_RATE_LIMIT=
# Comma-separated list of allowed Origin headers, e.g. https://newdec.am,https://www.newdec.am
ALLOWED_ORIGINS=
# Cloudflare Turnstile (both keys together enable the check)
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# ── Build options ─────────────────────────────────────────────────────────────────────────
# Public URL of the production site, used for canonical, Open Graph and structured data.
SITE_URL=
# Form endpoint used by the browser. Keep the default on Vercel.
VITE_INQUIRY_ENDPOINT=/api/inquiry
